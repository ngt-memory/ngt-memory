# NGT Memory API — configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Optional: protect API with a secret key ───────────────────────────────────
# If set — all requests require header: X-Api-Key: <value>
# Leave empty for open access (single-user or trusted network)
NGT_API_SECRET=

# ── LLM provider ──────────────────────────────────────────────────────────────
# Base URL of an OpenAI-compatible endpoint. Leave empty for official OpenAI.
# For YandexGPT: https://llm.api.cloud.yandex.net/v1
OPENAI_BASE_URL=

# ── Models ────────────────────────────────────────────────────────────────────
NGT_CHAT_MODEL=gpt-4.1-nano
NGT_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector size — MUST match the embedding model.
# 1536 for text-embedding-3-small, 256 for YandexGPT.
NGT_EMBEDDING_DIM=1536

# ── YandexGPT example (OpenAI-compatible) ─────────────────────────────────────
# OPENAI_API_KEY=<your-yandex-cloud-Api-Key>
# OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# NGT_CHAT_MODEL=gpt://<folder_id>/yandexgpt/latest
# NGT_EMBEDDING_MODEL=emb://<folder_id>/text-search-doc/latest
# NGT_EMBEDDING_DIM=256

# ── Memory settings ───────────────────────────────────────────────────────────
NGT_MEMORY_TOP_K=5          # memories injected per turn
NGT_MEMORY_THRESHOLD=0.25   # min cosine score to include a memory (0.0-1.0)
NGT_USE_GRAPH=true          # enable graph-boosted retrieval (recommended)

# ── Session settings ──────────────────────────────────────────────────────────
NGT_SESSION_TTL=3600        # session inactivity timeout in seconds
NGT_MAX_SESSIONS=100        # max concurrent sessions

# ── Persistence ───────────────────────────────────────────────────────────────
# Directory for on-disk session state (inside container when using Docker).
# Empty = persistence disabled (sessions die on restart / TTL).
NGT_PERSIST_DIR=/data/sessions
# Background save interval for all active sessions, seconds
NGT_PERSIST_INTERVAL=300

# ── Server ────────────────────────────────────────────────────────────────────
# NGT_ROOT_PATH=/api       # set if behind reverse proxy (e.g. nginx → /api)

# ── CORS ──────────────────────────────────────────────────────────────────────
NGT_CORS_ORIGINS=*          # allowed origins, comma-separated
