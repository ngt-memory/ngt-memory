# ─────────────────────────────────────────────────────────────────────
# NGT Memory API — пример конфигурации (v0.24.0)
# Скопируйте в .env и заполните. Все переменные — с префиксом NGT_,
# кроме OPENAI_* (совместимость с OpenAI SDK).
# ─────────────────────────────────────────────────────────────────────

# ── Провайдер LLM (обязательно) ──────────────────────────────────────
OPENAI_API_KEY=sk-...
# Пусто = официальный OpenAI. Для YandexGPT:
# OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
OPENAI_BASE_URL=

# ── Модели ───────────────────────────────────────────────────────────
NGT_CHAT_MODEL=gpt-4.1-nano
NGT_EMBEDDING_MODEL=text-embedding-3-small
NGT_EMBEDDING_DIM=1536

# ── Память (retrieval) ───────────────────────────────────────────────
NGT_MEMORY_TOP_K=5
NGT_MEMORY_THRESHOLD=0.25
NGT_USE_GRAPH=true

# ── Сессии ───────────────────────────────────────────────────────────
NGT_SESSION_TTL=3600
NGT_MAX_SESSIONS=100

# ── [Правка 2] Глобальный бюджет памяти ──────────────────────────────
# Суммарные лимиты по ВСЕМ сессиям. При превышении — вытеснение
# (eviction) старейших незанятых сессий (с сохранением на диск, если
# включён NGT_PERSIST_DIR).
NGT_MAX_TOTAL_ENTRIES=200000
NGT_MAX_TOTAL_MB=2048

# ── [Правка 4] Backend сессий ────────────────────────────────────────
# memory — in-process (по умолчанию). Безопасен только с 1 воркером.
# redis  — состояние в Redis, корректно при N воркерах/инстансах
#          без sticky sessions. Требует пакеты redis>=5.0 и safetensors.
NGT_SESSION_BACKEND=memory
NGT_REDIS_URL=redis://localhost:6379/0

# ── Персистентность на диск (только backend=memory) ──────────────────
# Пусто = выключено (память живёт только в RAM до рестарта).
# Каталог = сессии сохраняются в безопасном v2-формате (safetensors+json,
# [Правка 3]) и переживают рестарт. Старые .pt мигрируются автоматически.
NGT_PERSIST_DIR=
NGT_PERSIST_INTERVAL=300

# ── [Правка 5] Rate limiting (token bucket per API-key/IP) ───────────
# 0 = выключено. >0 = устойчивая частота запросов/сек, burst = всплеск.
# Для строгого глобального лимита при multi-worker используйте nginx
# limit_req или Redis-лимитер на уровне прокси.
NGT_RATE_LIMIT_RPS=0
NGT_RATE_LIMIT_BURST=20

# ── [Правка 5] Prometheus-метрики ────────────────────────────────────
# true = эндпоинт GET /metrics (требует prometheus-client).
NGT_METRICS_ENABLED=true

# ── Воркеры (см. NGT_SESSION_BACKEND) ────────────────────────────────
# >1 разрешён только при NGT_SESSION_BACKEND=redis. Иначе принудительно 1.
NGT_WORKERS=1
NGT_HOST=0.0.0.0
NGT_PORT=9190

# ── Auth / CORS ──────────────────────────────────────────────────────
# Опциональный общий секрет (X-API-Key header), timing-safe сравнение.
NGT_API_SECRET=
# CORS: '*' отключает credentials. Для credentialed-запросов укажите
# явные origin'ы через запятую.
NGT_CORS_ORIGINS=*

# ── Логирование ──────────────────────────────────────────────────────
NGT_LOG_LEVEL=INFO
NGT_LOG_JSON=true
